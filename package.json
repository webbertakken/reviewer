{
  "name": "reviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": "./index.js",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "wrangler dev src/index.mts",
    "deploy": "wrangler deploy src/index.mts --env production",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "lint": "eslint src --max-warnings 0",
    "fix": "eslint src --max-warnings 0 --fix",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "typecheck": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts)": "bash -c 'tsc --skipLibCheck --noEmit'",
    "*.@(ts|tsx|mts|js|jsx|mjs)": "eslint --max-warnings 0",
    "*.@(ts|tsx|mts|js|jsx|mjs|json|jsonc|json5|md|mdx|yaml|yml)": "prettier --write"
  },
  "nodemonConfig": {
    "delay": 100
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.0",
    "@octokit/types": "^18.0.0",
    "@octokit/webhooks": "^14.2.0",
    "chatgpt": "^5.2.5",
    "dotenv": "^18.0.0",
    "esm": "^3.2.25",
    "octokit": "^5.0.0",
    "toucan-js": "^4.0.0",
    "ts-dedent": "^2.2.0",
    "wrangler": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "=9.1.7",
    "lint-staged": "=17.6.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "uuid@^9.0.0": "^14.0.0",
    "@octokit/plugin-paginate-rest@^6.1.2": "^16.0.0",
    "@octokit/request@^6.0.0": "^10.0.0",
    "@octokit/request@^7.0.0": "^10.0.0",
    "@octokit/request-error@^3.0.0": "^7.0.0",
    "@octokit/request-error@^4.0.1": "^7.0.0",
    "@octokit/request-error@^4.0.2": "^7.0.0"
  },
  "packageManager": "yarn@3.6.0",
  "volta": {
    "node": "26.13.0",
    "yarn": "3.6.0"
  }
}
