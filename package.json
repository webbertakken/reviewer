{
  "name": "reviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": "./index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev src/index.mts",
    "deploy": "wrangler deploy src/index.mts --env production",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "lint": "eslint src --max-warnings 0",
    "fix": "eslint src --max-warnings 0 --fix",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "typecheck": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts)": "bash -c 'tsc --skipLibCheck --noEmit'",
    "*.@(ts|tsx|mts|js|jsx|mjs)": "eslint --max-warnings 0",
    "*.@(ts|tsx|mts|js|jsx|mjs|json|jsonc|json5|md|mdx|yaml|yml)": "prettier --write"
  },
  "nodemonConfig": {
    "delay": 100
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@octokit/auth-app": "^5.0.6",
    "@octokit/rest": "^19.0.13",
    "@octokit/types": "^10.0.0",
    "chatgpt": "^5.2.5",
    "dotenv": "^18.0.0",
    "esm": "^3.2.25",
    "octokit": "^3.2.2",
    "toucan-js": "^3.1.0",
    "ts-dedent": "^2.2.0",
    "wrangler": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.1",
    "globals": "^17.13.0",
    "husky": "=8.0.3",
    "lint-staged": "=13.2.1",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "typescript": "^5.1.5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "tinypool@^1.1.1": "^2.2.0",
    "undici@^5.28.5": "^6.29.1",
    "zod@3.22.3": "^4.6.6",
    "sharp@^0.33.5": "^0.35.5",
    "esbuild@0.17.19": "^0.25.0",
    "ws@8.18.0": "^8.22.0",
    "miniflare@3.20250718.3": "patch:miniflare@npm%3A3.20250718.3#./.yarn/patches/miniflare-npm-3.20250718.3-248a288d9b.patch"
  },
  "packageManager": "yarn@3.6.0",
  "volta": {
    "node": "20.20.2",
    "yarn": "3.6.0"
  }
}
